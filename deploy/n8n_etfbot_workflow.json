      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⚠️ <b>ETF bot skipped today: data check failed</b>\n{{ ($json.quality.issues || []).slice(0, 5).join('\\n') }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "9830a1df-e9a4-44c3-a2c8-7f8f24880925",
